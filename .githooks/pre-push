#!/bin/sh
# Refuse any push that updates or deletes `main` directly.
#
# Changes reach main only through a pull request. GitHub enforces this with the
# "Protect main" ruleset (.github/rulesets/protect-main.json); this hook catches
# the mistake locally, before anything is sent. Activated by `npm install`
# (the `prepare` script sets core.hooksPath to .githooks).

protected="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected" ]; then
    echo "" >&2
    echo "  Direct pushes to main are not allowed." >&2
    echo "  Push a branch and open a pull request instead:" >&2
    echo "    git switch -c my-change && git push -u origin my-change" >&2
    echo "" >&2
    exit 1
  fi
done

exit 0
