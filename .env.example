# Copy these settings into your root .env (or .env.local). Keep existing database/auth settings.
# This file is committed — never put real secrets in it.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Must match the intelligence service's AUTH_SECRET.
AUTH_SECRET=replace-with-a-long-random-secret
# Optional — leave blank to use the local hashing embedder.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBED_DIM=384
# Local development only. Leave unset in deployments without the service —
# unset means link intelligence is off.
INTELLIGENCE_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_IS_DEMO_MODE=false
# Optional: Google OAuth (falls back to a demo session when blank)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: billing
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
